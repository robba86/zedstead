# Copy to .env and edit. Consumed by docker-compose.yml -> the systemd bootstrap.
# On each boot `zsm container-init` MERGES these values into config.json — only
# the fields below are touched; app-configured settings (scheduled tasks, mods,
# Discord, restart warnings) are preserved. Set ZSM_WRITE_CONFIG=0 to skip the
# merge entirely and use ./config/config.json as-is.

# Steam account that OWNS DayZ (no anonymous login). Password/2FA are NOT set
# here — you cache the login token once with `zsm steam-login` (see compose).
STEAM_USERNAME=

# Server identity / network
# SERVER_NAME sets zsm's label AND the serverDZ.cfg `hostname` (the name players
# see in the browser). Written on each boot unless ZSM_WRITE_CONFIG=0.
SERVER_NAME=My DayZ Server
# Ports: docker-compose.yml uses `network_mode: host`, so nothing is published
# and every port below opens directly on the host, on every interface; the
# host firewall (ufw) applies. That includes `zsm web` (0.0.0.0:8433,
# self-signed HTTPS unless `web_bind_host` is set) and BattlEye RCon (every
# interface unless beserver_x64.cfg sets `RConIP 127.0.0.1`). SERVER_PORT_END
# and WEB_PORT feed only the commented-out bridge-mode `ports:` block in
# docker-compose.yml and do nothing with host networking.
SERVER_PORT=2302                 # server -port= launch arg (game / voice /
                                 # extra use SERVER_PORT..SERVER_PORT+4)
#SERVER_PORT_END=2306            # bridge mode only: end of the published UDP
                                 # range — set to SERVER_PORT+4 if you change
                                 # SERVER_PORT (compose can't compute it)
#STEAM_QUERY_PORT=27016          # Steam A2S query port — written into
                                 # serverDZ.cfg `steamQueryPort` on each boot
                                 # (like SERVER_NAME). Unset = leave
                                 # serverDZ.cfg alone (default 27016).
#WEB_PORT=8433                   # bridge mode only: host port for `zsm web`,
                                 # which also serves the Map Editor
                                 # (opt-in — run
                                 # `docker compose exec -u zsm dayz zsm web`).
                                 # With host networking it listens on 8433;
                                 # `zsm web --port N` moves it.
# RCON_PORT/RCON_PASSWORD are written into BattlEye's beserver_x64.cfg (what the
# server listens with) AND used by zsm's RCON client — kept in sync each boot.
# RCON_PASSWORD empty = zsm generates a random one on first boot and keeps it;
# read it in the app under Configs -> BattlEye. RCon can kick, ban and shut
# the server down, so if you set your own, make it long and random. The old
# placeholder `changeme` is never used: the bootstrap replaces it.
RCON_PORT=2305
RCON_PASSWORD=

# DayZServer launch args. Left out, zsm keeps them in its own config and
# the app's Run Command page edits them; set here, they are rewritten at
# every start and read-only in the app.
# SERVER_ARGS=-adminLog -netLog -freezeCheck -cpuCount=2 -doLogs

# Which DayZ server to install: stable (default) or experimental, Bohemia's
# pre-release build (Steam app 1042420) that only players on DayZ Experimental
# can join. A server directory holds one or the other: zsm refuses to update
# a stable install as Experimental, so switch on a fresh SERVER_DIR.
#SERVER_BRANCH=stable

# Mod load order: managed by zsm (the mod list + PBO dependency resolution), same
# as a host install — you normally don't set this. The `-mod=` string is built
# by the service unit itself.

# Behavior toggles
# START_SERVER: 0 (default) = boot idle; manage the server from the web UI
#   (`docker compose exec -u zsm dayz zsm` -> Start/Stop) or `zsm start`.
#   1 = auto prep (`zsm -y run all`) + launch the server on boot (headless box).
START_SERVER=0
ZSM_SETUP_ON_BOOT=1    # 1 = run `zsm setup` each boot (idempotent): install
                        #     the server if a Steam token is cached.
                        #     Set 0 to skip.
ZSM_UPDATE_ON_BOOT=1   # 1 = run `zsm -y run all` (update+mods+merge) before
                        #     auto-start — only applies when START_SERVER=1.
ZSM_WRITE_CONFIG=1     # 1 = merge this env into config.json each boot (default).
                        # Set 0 to skip the merge and use config.json as-is.

# Where zsm writes backups + server bundle exports. Defaults match the
# ./backups and ./bundles host volumes in docker-compose.yml — only change
# these if you also change the compose volume targets.
BACKUP_DIR=/home/zsm/backups
BUNDLE_EXPORT_DIR=/home/zsm/bundles

# Match the container user to your host so bind-mounted volumes stay writable.
# Set to the output of `id -u` / `id -g` (usually 1000).
UID=1000
GID=1000
