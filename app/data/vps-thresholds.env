# Thresholds for the VPS-readiness checks. SINGLE SOURCE OF TRUTH.
#
# Read by:
#   * app/ops/vps_readiness.py       -> `zsm doctor` / `zsm doctor --preflight`
#   * preflight.sh                   -> mirrored into its generated block;
#                                       tests/test_vps_readiness.py fails if the
#                                       two drift (preflight.sh is fetched over
#                                       curl with no repo behind it, so it cannot
#                                       read this file)
# When the sizing calculator (TODO-2 F2) and the hardware buying advice (A7) are
# built they must read these numbers too — do not start a second list.
# See plans/23.
#
# Format: KEY=value only. No quoting, no expansion, no spaces around `=` —
# this file is `.`-sourced by POSIX sh as well as parsed by Python.
#
# Numbers come from TODO-2 F2's sizing rules of thumb (vanilla 60 slots
# ~4-6 GB, lightly modded ~6-8 GB, Expansion + 40-60 players ~16 GB) and A3's
# swap rule (swap when RAM < 12 GB).
MIN_CORES=2
MIN_MHZ=2400
MAX_STEAL_PCT=5
# RAM is judged as ADVERTISED size, not as MemTotal: 4096 here means "a box
# sold as 4 GB". A guest never presents its nominal size — two VPS plans,
# both sold as 4 GB, reported 3814 MB and 3557 MB, so comparing
# MemTotal directly rejected every 4 GB box for not having 4 GB. The
# measurement is normalised first; see advertised_ram_mb() in
# app/ops/vps_readiness.py. RAM_ROUND_TOLERANCE_PCT is how far below a plan
# size a box may measure and still count as that plan (worst shortfall
# measured: 13.2%).
MIN_RAM_MB=4096
RAM_ROUND_TOLERANCE_PCT=15
# The verdict tiers, in the same advertised-MB units. MIN_RAM_MB opens the
# "vanilla, roughly 20 slots" tier; each key below opens the next one. These
# used to be literals inside verdict(), which is how the verdict could call a
# box too small while the RAM row on the same screen passed it.
TIER_VANILLA_MB=6144
TIER_MODDED_LIGHT_MB=8192
TIER_MODDED_HEAVY_MB=16384
SWAP_REQUIRED_BELOW_MB=12288
MIN_DISK_GB=30
MIN_FILE_MAX=100000
MIN_NOFILE=65536
