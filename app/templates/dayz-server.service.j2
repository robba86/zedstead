[Unit]
Description={{ description }}
After=network-online.target
# The crash-loop brake. With Restart=always below, a server that cannot start
# comes back every RestartSec seconds for ever; after StartLimitBurst starts inside
# StartLimitIntervalSec, systemd stops and leaves the unit `failed` — a state
# zsm can see and report. Both belong in this section (systemd >= 229) and
# are silently ignored in the Service one. StartLimitIntervalSec=0 disables
# the limit entirely.
# zsm's own start/restart runs `reset-failed` first, so a human restarting
# several times in a row never trips it. Values come from DayzConfig.
StartLimitIntervalSec={{ start_limit_interval }}
StartLimitBurst={{ start_limit_burst }}

[Service]
Type=simple
User={{ user }}
WorkingDirectory={{ server_dir }}
ExecStart=/bin/bash -c 'exec ./DayZServer "-config={{ config_path }}" {{ mod_arg }} "-profiles={{ profiles_path }}" "-BEpath={{ battleye_path }}" {{ server_args }} -port={{ server_port }}'
Restart={{ restart }}
RestartSec={{ restart_sec }}
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
