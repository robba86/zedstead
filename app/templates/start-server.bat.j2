@echo off
cls
REM DayZ Dedicated Server — Start Script
REM Generated by zsm

set watch=DayZ Server
title %watch% Watchdog
cd /d "{{ server_dir }}"

:watchdog
echo (%time%) %watch% started.
start /wait "" "DayZServer_x64.exe" "-config={{ config_path }}" {{ mod_arg }} "-profiles={{ profiles_path }}" "-BEpath={{ battleye_path }}" {{ server_args }} -port={{ server_port }}
echo (%time%) %watch% closed or crashed, restarting in 10 seconds...
timeout /t 10 /nobreak >nul
goto watchdog