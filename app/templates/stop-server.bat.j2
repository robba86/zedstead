@echo off
REM DayZ Dedicated Server — Stop Script
REM Generated by zsm

REM Kill the watchdog batch process first so it cannot restart the server.
REM Match by command line (works for minimized/hidden windows too) instead of
REM window title — `taskkill /FI "WINDOWTITLE eq ..."` silently misses minimized cmd windows.
powershell -NoProfile -NonInteractive -Command "Get-CimInstance Win32_Process -Filter \"Name='cmd.exe'\" | Where-Object { $_.CommandLine -like '*start-server.bat*' } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force }" >nul 2>&1

REM Graceful terminate (no /F) — lets the server save persistence data
taskkill /IM DayZServer_x64.exe

echo Waiting for DayZ server to shut down...
:wait
timeout /t 2 /nobreak >nul
tasklist /FI "IMAGENAME eq DayZServer_x64.exe" | find "DayZServer_x64.exe" >nul
if %errorlevel%==0 goto wait

echo DayZ server stopped gracefully.
